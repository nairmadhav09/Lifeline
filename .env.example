# Supabase — Project Settings → API (or API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The anon / publishable key. Safe in the browser: Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only (service_role / secret key). Used by the seed script, the RLS test and
# account deletion. Never expose it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: public site URL used for auth redirects (defaults to the request origin)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
